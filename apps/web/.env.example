# Copy to .env.local for local development.

# apothem-api base URL (server-side only, never exposed to the browser)
APOTHEM_API_URL=http://localhost:3001

# --- Sign-in (ADR-012) -------------------------------------------------------
# Auth.js session cookie encryption. Generate with: openssl rand -base64 32
APOTHEM_SESSION_SECRET=replace-with-a-long-random-value
# Public URL of this app (required in production; Vercel sets it automatically)
# AUTH_URL=http://localhost:3000

# Google OAuth client (Google Cloud Console > APIs & Services > Credentials).
# Redirect URI: <app url>/api/auth/callback/google. Leave unset to disable Google sign-in.
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# Optional closed beta: comma separated emails or @domains allowed to sign in. Empty = open.
# APOTHEM_SIGNUP_ALLOWLIST=@yourcompany.com,partner@example.com

# Signs the short-lived bearer token sent to apothem-api. Must match the API settings:
#   APOTHEM_API_TOKEN_SECRET   = API AUTH_SECRET (32+ chars, different from APOTHEM_SESSION_SECRET)
#   APOTHEM_API_TOKEN_ISSUER   = API AUTH_JWT_ISSUER
#   APOTHEM_API_TOKEN_AUDIENCE = API AUTH_JWT_AUDIENCE
# APOTHEM_API_TOKEN_SECRET=
# APOTHEM_API_TOKEN_ISSUER=https://app.apothemai.com.br
# APOTHEM_API_TOKEN_AUDIENCE=apothem-api